# Copy to .env and fill in. Nothing here is required for `python main.py --mock --no-email`.

# --- Delivery: mails the lead REPORT to you. Never used for prospect outreach. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RECIPIENT_EMAIL=

# --- Sourcing: pick ONE. Apify is preferred (card-free, exposes social fields). ---
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
APIFY_MAX_PLACES_PER_SEARCH=20
# This repo asks Apify for ALL places (not just website-less ones) so it can see
# businesses whose Maps "website" is an Instagram URL. That returns more items
# per sweep than scraper2 would, so keep this cap tight to stay in free credits.
APIFY_MAX_SEARCHES=12

# Weak fallback: the Places API has no social fields, so it can only spot a
# social-only business when its Instagram URL sits in the websiteUri slot.
GOOGLE_PLACES_API_KEY=

# --- Filtering ---
# Keep nearby non-NCR businesses (they're still customers). true = drop them.
NCR_ONLY=false
MAX_TARGETS=0

# --- Lead tiers ---
GOLDENROD_MIN_RATING=4.5
GOLDENROD_MIN_REVIEWS=500

# --- Output ---
OUTPUT_DIR=output
CONTACTED_FILE=reported_businesses.xlsx

# --- Anti-ban (optional) ---
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.5
BACKOFF_MAX_SECONDS=30
JITTER_MIN_SECONDS=0.8
JITTER_MAX_SECONDS=2.5
PROXY_LIST=
PROXY_FILE=proxies.txt
PROXY_MAX_FAILURES=3
