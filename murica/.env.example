# Murica settings. Copy to .env to override; anything left unset falls back to
# launcher/.env then scraper2/.env (which already hold working APIFY_TOKEN and
# RESEND_API_KEY), so an empty/missing .env is fine.

# Where the finished sheet is emailed. NEVER the office inbox.
MURICA_RECIPIENT=ashutosh06066@gmail.com

# Resend (fallback: launcher/.env, scraper2/.env)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Apify Google Maps Scraper (fallback: launcher/.env, scraper2/.env)
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
# Cost knobs, MURICA_* on purpose so scraper2's bigger caps never leak in.
# One run bills at most MURICA_MAX_SEARCHES x MURICA_PLACES_PER_SEARCH places.
MURICA_MAX_SEARCHES=6
MURICA_PLACES_PER_SEARCH=25

# The lead definition. WHOIS lookups themselves are free.
MURICA_MIN_AGE_YEARS=10
MURICA_RESULTS_PER_RUN=10

# 0 = unlimited candidates from one Apify run
MAX_TARGETS=0
