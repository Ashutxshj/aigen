# Copy to .env and fill in. Keys leeds itself needs (GEMINI_API_KEY etc.) live
# in ../leeds/.env and are picked up from there automatically.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where the hourly sheet goes. Resend's free tier only delivers to the email
# that owns the Resend account until you verify a domain.
RESEND_TO=

# Only after verifying a domain in Resend:
# RESEND_FROM=leeds-hour <you@yourdomain.com>
