# Niche settings. Copy to .env to override; anything left unset falls back to
# scraper2/.env (which already holds working APIFY_TOKEN and RESEND_API_KEY),
# so an empty/missing .env is fine.

# Where the finished sheet is emailed. NEVER the office inbox.
NICHE_RECIPIENT=ashutosh06066@gmail.com

# Resend (fallback: scraper2/.env)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Apify Google Maps Scraper (fallback: scraper2/.env)
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
# Cost knobs: queries = min(cities, APIFY_MAX_SEARCHES) x places per search.
APIFY_MAX_PLACES_PER_SEARCH=20
APIFY_MAX_SEARCHES=8

# Google Places API (New) — only used when no APIFY_TOKEN anywhere.
GOOGLE_PLACES_API_KEY=

# 0 = unlimited
MAX_TARGETS=0
