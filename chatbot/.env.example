# Copy to .env and fill in what you have. EVERY key is optional: a collector
# without its credentials logs one "skipped" line and the run continues.
#
# With no keys at all you still get: Hacker News, Freelancer.com, OpenStreetMap,
# and new-domain detection. Reddit needs a (free) app; Gemini needs a (free) key.

# --- Reddit ------------------------------------------------------------------
#
# YOU DO NOT NEED A REDDIT ACCOUNT. Leave all of this blank.
#
# By default (USE_REDDIT_PUBLIC=1) Reddit is read through Arctic Shift, the public
# archive that replaced Pushshift: no app, no client id, no login, and your Reddit
# account is never touched. It serves posts AND comments, and measured lag on
# 2026-07-11 was 0.0h for comments and 0.1-4.7h for posts — effectively live.
#
# (Reddit's own unauthenticated .json endpoints are dead: www.reddit.com and
# old.reddit.com both return 403 Blocked. Anything telling you to just append
# .json is out of date.)
USE_REDDIT_PUBLIC=1

# Only if you have credentials AND want the official OAuth route instead.
# Set USE_REDDIT_PUBLIC=0 to use these. It is read-only and cannot post as you,
# but creating the app requires logging in — which is exactly what you may not
# want to do.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:com.chillispark.leeds:v0.1.0 (by /u/your_handle)

# --- Google search (the widest net) -------------------------------------------
#
# Reaches everything with no API of its own — Quora, trade forums, WordPress and
# Shopify support boards, Facebook pages — and gives a SECOND, independent route
# to Reddit posts. Free: 100 queries/day, no card.
#
#   1. GOOGLE_CSE_KEY — enable "Custom Search API", then make an API key:
#      https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#      This is NOT your GEMINI_API_KEY. Different product, different key.
#
#   2. GOOGLE_CSE_CX — https://programmablesearchengine.google.com/ -> Add ->
#      then open the engine's settings and turn ON "Search the entire web".
#      ^^^ IF YOU SKIP THAT, IT SEARCHES ONLY THE SITES YOU LISTED (i.e. none),
#          returns zero results for every query, and looks perfectly healthy.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Optional fallback: 2,000 queries/month free, also no card.
BRAVE_API_KEY=

# --- Gemini (scoring + drafting) ---------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without it, the tool falls back to rule-only scoring and writes no openers.
GEMINI_API_KEY=
# Your free-tier RPM is per-account; check https://aistudio.google.com/rate-limit
# and lower this if you get 429s.
GEMINI_MIN_INTERVAL=6.0

# --- Optional extras ---------------------------------------------------------
# Stack Exchange: free, and lifts the quota from 300/day to 10,000/day.
STACKEXCHANGE_KEY=

# Bluesky post search REQUIRES auth. Settings -> App Passwords (free).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# UK Companies House: free key. Companies incorporated in the last 48h — which by
# definition do not have a website yet. Nobody works this source.
#   1. https://developer.company-information.service.gov.uk/ -> sign up
#   2. Create an application -> choose LIVE (not test) -> copy the REST API key
#
# Auth is HTTP Basic with the key as the USERNAME and an EMPTY password. That
# trailing colon in their docs is load-bearing:
#     curl -XGET -u YOUR_KEY: https://api.company-information.service.gov.uk/company/00000006
#                          ^ empty password
# Put the key as the password instead and you get a 401 that looks exactly like a
# bad key. The collector already does this correctly — you just paste the key.
COMPANIES_HOUSE_KEY=

# Google Places lost its free credit in March 2025 and now needs a billing card.
# OFF by default. Only turn this on if you accept the bill.
GOOGLE_PLACES_API_KEY=
ENABLE_PLACES=0

# JustDial has no API. Scraping it violates their ToS and they block hard.
# OFF by default. Yelp is not supported at all — it went paid.
ENABLE_JUSTDIAL=0

# --- Paths -------------------------------------------------------------------
# The output sheet. Deliberately NOT leads_master.xlsx — this repo never touches
# that file.
# INTENT_FILE=../intent_leads.xlsx
# LEEDS_DB=leads.db

# Your email, used in the bot User-Agent so platforms can contact you.
CONTACT_EMAIL=
